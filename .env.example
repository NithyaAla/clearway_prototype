# Copy this file to .env.local and paste your key.
# Get a key at https://platform.claude.com (Console > API keys).
ANTHROPIC_API_KEY=

# Optional: set to true to force saved examples (no AI calls, no cost).
DEMO_MODE=false

# Optional: max AI requests per visitor per 10 minutes (default 40).
# RATE_LIMIT_PER_10_MIN=40
